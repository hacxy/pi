#!/bin/bash
set -euo pipefail

# afk —— Ralph 工作流（issue 模式）：离开键盘，逐条处理当前仓库的开放 AFK issue
#
# 用法: afk <迭代次数>
#   每一轮：
#     1. gh issue list --state open --label afk 拉取当前仓库所有开放 AFK issue
#        （number/title/body/comments 一次取齐）
#     2. 编号升序取第一条；本轮已 ABORT/SKIP 过的编号跳过（跳过集合 per-run，
#        进程内维护，run 启动即为空）
#     3. 把该 issue 物化为 markdown 上下文文件，交给 once 执行一轮
#   每一轮都是全新的 pi 会话（pi -p --mode json），只携带最近 10 条
#   Ralph 提交作为进度上下文。
#
# 退出码:
#   0 = 全部完成（无开放 AFK issue / NO MORE TASKS）
#   2 = 达到迭代上限仍有任务；或剩余开放 issue 全部不可工作（已跳过）
#   3 = 用法/参数/环境错误（含 gh 拉取失败）
#
# 依赖: pi（在 PATH 中）、jq、git、gh（已登录，可用 --label afk 过滤）
#       （once 额外依赖 python3）

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
ONCE_SCRIPT="$SCRIPT_DIR/once"
WORK_DIR="$(mktemp -d /tmp/afk.XXXXXX)"
trap 'rm -rf "$WORK_DIR"' EXIT

if [ "$#" -ne 1 ] || ! [[ "${1:-}" =~ ^[1-9][0-9]*$ ]]; then
  echo "用法: afk <迭代次数>  （正整数，如 afk 10）" >&2
  exit 3
fi
iterations="$1"

skipped=()   # 本轮已 ABORT/SKIP 的 issue 编号（per-run 跳过集合）

# 拉取开放 AFK issues（失败重试一次）
fetch_issues() {
  local out
  for try in 1 2; do
    if out="$(gh issue list --state open --label afk --json number,title,body,comments 2>&1)"; then
      printf '%s' "$out"
      return 0
    fi
    echo "WARN: gh issue list 拉取失败（第 ${try} 次），重试..." >&2
  done
  echo "错误: 无法拉取 GitHub issues（gh issue list 连续失败）" >&2
  exit 3
}

# 从 issues JSON 中挑第一条：编号升序、排除跳过集合；无候选输出 null
pick_issue() {
  local prog='[.[]'
  if [ "${#skipped[@]}" -gt 0 ]; then
    for n in "${skipped[@]}"; do
      prog+=" | select(.number != $n)"
    done
  fi
  prog+='] | sort_by(.number) | .[0]'
  jq -c "$prog" 2>/dev/null || echo null
}

for ((i=1; i<=iterations; i++)); do
  issues="$(fetch_issues)"
  issue="$(printf '%s' "$issues" | pick_issue)"

  if [ -z "$issue" ] || [ "$issue" = "null" ]; then
    if [ "${#skipped[@]}" -gt 0 ]; then
      echo "Ralph: 剩余开放 AFK issue 均不可工作（本轮已跳过 ${#skipped[@]} 个：ABORT/SKIP），中止。"
      exit 2
    fi
    echo "Ralph: NO MORE TASKS —— 无开放 AFK issue。"
    exit 0
  fi

  echo "------- ITERATION $i --------"
  num="$(printf '%s' "$issue" | jq -r '.number')"
  title="$(printf '%s' "$issue" | jq -r '.title')"
  ctx="$WORK_DIR/issue-$num.md"
  printf '%s' "$issue" | jq -r '
    "# Issue #\(.number): \(.title)\n\n\(.body // "")\n\n" +
    (if (.comments | length) > 0 then "## 评论\n\n" + ([.comments[] | "- **\(.author.login)**: \(.body)"] | join("\n\n")) else "" end)
  ' > "$ctx"

  echo "  处理 issue #$num: $title"
  # set -e 陷阱：不能用 `"$ONCE_SCRIPT"; rc=$?` —— once 返回非零（正常结束=2/跳过=4）时
  # errexit 会在 rc=$? 执行前杀掉脚本，导致迭代数 >1 也只跑一轮就静默退出。
  # 必须用 if 形式（if 条件中的命令不受 errexit 约束）捕获退出码。
  if "$ONCE_SCRIPT" "$ctx"; then
    rc=0
  else
    rc=$?
  fi

  case "$rc" in
    0)
      echo "Ralph complete after $i iterations."
      exit 0
      ;;
    1)
      echo "Ralph: issue #$num ABORT（被阻塞），跳过该 issue，继续下一轮。"
      skipped+=("$num")
      ;;
    2)
      : # 本轮正常结束（issue 可能已完成被关闭，或未完成待下轮续做）
      ;;
    3)
      echo "Ralph: 用法/参数/环境错误，中止。"
      exit 3
      ;;
    4)
      echo "Ralph: issue #$num SKIP（HITL/父PRD/依赖未满足，不可无人值守），跳过，继续下一轮。"
      skipped+=("$num")
      ;;
    *)
      echo "Ralph: once 返回未知退出码 $rc，中止。"
      exit 3
      ;;
  esac
done

echo "Ralph: 达到迭代上限 ($iterations)，仍有任务未完成。"
exit 2
