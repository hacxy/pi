#!/bin/bash
set -euo pipefail

# afk —— Ralph 工作流：离开键盘，循环执行任务直到完成或达到迭代上限
#
# 用法: afk <文档1> <文档2> <迭代次数>
#   两个文档顺序可变（如 PRD 与 PLAN），最后一个参数为迭代次数。
#   每一轮都是全新的 pi 会话（pi -p --mode json），只携带最近 10 条
#   Ralph 提交作为进度上下文。
#
# 退出码:
#   0 = 全部完成 (NO MORE TASKS)
#   1 = 中止 (ABORT)
#   2 = 达到迭代上限，仍有任务未完成（可续跑：进度在 git 里，天然支持）
#   3 = 用法/参数/环境错误
#
# 依赖: pi（在 PATH 中）、jq、git

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
ONCE_SCRIPT="$SCRIPT_DIR/once"

# 解析参数：最后一个参数若是纯数字则为迭代次数，其余为文档
if [[ "${@: -1}" =~ ^[0-9]+$ ]]; then
  iterations="${@: -1}"
  docs=("${@:1:$#-1}")
else
  echo "用法: afk <prd.md> <plan.md> <迭代次数>  （两个文档顺序可变）" >&2
  exit 3
fi

if [ "${#docs[@]}" -lt 2 ]; then
  echo "用法: afk <prd.md> <plan.md> <迭代次数>  （两个文档顺序可变）" >&2
  exit 3
fi

for ((i=1; i<=iterations; i++)); do
  echo "------- ITERATION $i --------"
  "$ONCE_SCRIPT" "${docs[@]}"
  rc=$?
  if [ "$rc" -eq 0 ]; then
    echo "Ralph complete after $i iterations."
    exit 0
  fi
  if [ "$rc" -eq 1 ]; then
    echo "Ralph aborted after $i iterations."
    exit 1
  fi
  if [ "$rc" -eq 3 ]; then
    echo "Ralph: 用法/参数/环境错误，中止。"
    exit 3
  fi
done

echo "Ralph: 达到迭代上限 ($iterations)，仍有任务未完成。"
exit 2
