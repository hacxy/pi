#!/usr/bin/env bash
# afk-run-v2 — containerized ralph/afk（issue 模式）: use the current directory
# as the project container and run the ralph issue loop inside it.
#
# Usage:
#   afk-run-v2 <iterations>   run ralph afk loop in container (issue mode)
#   afk-run-v2                no args: interactive mode (pi)
#
# Issue 模式: 脚本不再接收 PRD/Plan 文档。afk 每轮自动拉取当前仓库
# `--label afk` 的开放 issues（gh issue list），编号升序取一条交给 agent。
#
# Behavior:
#   - project identity = git remote origin repo name (fallback: dir name) -> <name>-afk
#   - create container if missing (bind cwd -> /workspace, skills+ralph ro mounts),
#     docker start if exists
#   - if bind source != cwd (same repo cloned twice) -> warn and recreate
#   - credentials auto-extracted: GH_TOKEN <- `gh auth token`;
#     DEEPSEEK_API_KEY <- ~/.pi/agent/auth.json (deepseek.key)
#   - runs `gh auth setup-git` in container once at creation (passwordless push)
#   - injects git user.name/email (from host global, fallback repo-local) into
#     container global config, so the first commit doesn't fail with
#     "Author identity unknown"
#   - shares the host pnpm store with the container (same absolute path): the
#     storeDir recorded in node_modules/.modules.yaml stays identical on both
#     sides, so host pnpm never triggers "modules directory will be removed
#     and reinstalled from scratch" after a container install
#
# Overrides: AFK_IMAGE / SKILLS_DIR / RALPH_HOME / AFK_GH_TOKEN / AFK_DEEPSEEK_KEY
#            RALPH_MODEL / RALPH_LOG / RALPH_SKILL (default /root/.pi/agent/skills/tdd)
set -euo pipefail

RALPH_HOME="${RALPH_HOME:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)}"
IMAGE="${AFK_IMAGE:-afk-base:latest}"
SKILLS_DIR="${SKILLS_DIR:-${HOME}/Projects/afk-shared/skills}"
CWD="$(pwd -P)"

# project identity: git remote origin repo name, fallback dir basename
project_name() {
  local url name
  url="$(git config --get remote.origin.url 2>/dev/null || true)"
  if [ -n "$url" ]; then
    name="$(basename "$url" .git)"
    name="${name##*[/:]}"        # strip https://host/org/ or git@host:org/
    [ -n "$name" ] && { echo "$name"; return; }
  fi
  basename "$CWD"
}

# credentials: env vars first, then auto-extract
gh_token() {
  if [ -n "${AFK_GH_TOKEN:-}" ]; then echo "$AFK_GH_TOKEN"; return; fi
  if [ -n "${GH_TOKEN:-}" ]; then echo "$GH_TOKEN"; return; fi
  command -v gh >/dev/null 2>&1 && gh auth token 2>/dev/null || true
}
deepseek_key() {
  if [ -n "${AFK_DEEPSEEK_KEY:-}" ]; then echo "$AFK_DEEPSEEK_KEY"; return; fi
  if [ -n "${DEEPSEEK_API_KEY:-}" ]; then echo "$DEEPSEEK_API_KEY"; return; fi
  local auth="${HOME}/.pi/agent/auth.json"
  if [ -f "$auth" ]; then
    python3 -c 'import json,os;print(json.load(open(os.path.expanduser("~/.pi/agent/auth.json"))).get("deepseek",{}).get("key",""))' 2>/dev/null || true
  fi
}
# git identity: 宿主全局配置优先，其次仓库本地配置（gh auth setup-git 只配
# credential helper，不会设置 user.name/email，容器里 git commit 会报
# "Author identity unknown"——这里显式注入到容器的全局配置）
git_identity() {
  local name email
  name="$(git config --global user.name 2>/dev/null || true)"
  email="$(git config --global user.email 2>/dev/null || true)"
  if [ -z "$name" ] || [ -z "$email" ]; then
    name="$(git config user.name 2>/dev/null || true)"
    email="$(git config user.email 2>/dev/null || true)"
  fi
  if [ -n "$name" ] && [ -n "$email" ]; then
    printf '%s\n%s\n' "$name" "$email"
  fi
}
# 宿主 pnpm store 目录（不含 /vN 版本后缀）：pnpm store path 取 dirname，
# 无 pnpm 时按平台默认路径。容器以相同绝对路径挂载并强制 store-dir，
# 使 .modules.yaml 两侧记录一致，避免宿主 pnpm 每次触发重装提示。
host_store_dir() {
  local p
  if command -v pnpm >/dev/null 2>&1; then
    p="$(pnpm store path 2>/dev/null || true)"
  fi
  if [ -z "$p" ]; then
    case "$(uname -s)" in
      Darwin) p="${HOME}/Library/pnpm/store" ;;
      Linux)  p="${HOME}/.local/share/pnpm/store" ;;
      *) return 1 ;;
    esac
  fi
  dirname "$p"
}

PROJECT="$(project_name)"
NAME="${PROJECT}-afk"
STORE_DIR="$(host_store_dir || true)"

# container lifecycle: exists && bind source matches -> start; else recreate
cid="$(docker ps -a -q -f "name=^/${NAME}$" 2>/dev/null || true)"
if [ -n "$cid" ]; then
  src="$(docker inspect -f '{{range .Mounts}}{{if eq .Destination "/workspace"}}{{.Source}}{{end}}{{end}}' "$NAME")"
  store_ok=1
  if [ -n "$STORE_DIR" ]; then
    if ! docker inspect -f '{{range .Mounts}}{{.Destination}} {{end}}' "$NAME" | grep -qF "$STORE_DIR"; then
      store_ok=0
    fi
  fi
  if [ "$src" != "$CWD" ] || [ "$store_ok" -eq 0 ]; then
    echo "WARN: container $NAME 挂载与当前配置不匹配（workspace 或 pnpm store），recreating" >&2
    docker rm -f "$NAME" >/dev/null
    cid=""
  fi
fi

if [ -z "$cid" ]; then
  [ -d "$SKILLS_DIR" ] || mkdir -p "$SKILLS_DIR"
  token="$(gh_token)"
  key="$(deepseek_key)"
  [ -n "$token" ] || echo "WARN: no GH_TOKEN (gh not logged in); pushes will fail" >&2
  [ -n "$key" ] || echo "WARN: no DEEPSEEK_API_KEY (auth.json has no deepseek key); pi cannot call models" >&2
  # 共享宿主 store：目录须先由宿主创建（避免 docker 以 root 创建导致宿主 pnpm 无法写入）
  # 注意: pnpm 11 起不再读取 npm_config_* 环境变量，必须用 pnpm_config_* 前缀；
  # minimum_release_age=0 与宿主行为对齐（pnpm 11 默认 1 天，会拒绝刚发布的包）
  store_args=()
  if [ -n "$STORE_DIR" ]; then
    mkdir -p "$STORE_DIR"
    store_args=(-v "$STORE_DIR:$STORE_DIR" -e "pnpm_config_store_dir=$STORE_DIR" -e "pnpm_config_minimum_release_age=0")
  else
    echo "WARN: 无法确定宿主 pnpm store 位置，容器将使用项目内 .pnpm-store（宿主会触发重装提示）" >&2
  fi
  docker run -d --name "$NAME" \
    -e DEEPSEEK_API_KEY="$key" \
    -e GH_TOKEN="$token" \
    "${store_args[@]}" \
    -v "$CWD:/workspace" \
    -v "$SKILLS_DIR:/root/.pi/agent/skills:ro" \
    -v "$RALPH_HOME:/opt/ralph:ro" \
    "$IMAGE" >/dev/null
  docker exec "$NAME" gh auth setup-git >/dev/null 2>&1 || true
  # 注入 git 身份（无身份时警告；容器用 --global 写 /root/.gitconfig）
  identity="$(git_identity)"
  if [ -n "$identity" ]; then
    name="$(printf '%s\n' "$identity" | sed -n 1p)"
    email="$(printf '%s\n' "$identity" | sed -n 2p)"
    docker exec "$NAME" git config --global user.name "$name" >/dev/null
    docker exec "$NAME" git config --global user.email "$email" >/dev/null
    echo "container $NAME git identity: $name <$email>"
  else
    echo "WARN: 宿主未配置 git user.name/user.email，容器内首次 commit 会失败（模型会自行设置或需要手动注入）" >&2
  fi
  echo "container $NAME created (bound to $CWD)"
else
  docker start "$NAME" >/dev/null
  echo "container $NAME started"
fi

# no args: interactive mode
if [ "$#" -eq 0 ]; then
  exec docker exec -it "$NAME" pi
fi

# with args: run ralph afk in container (pass through RALPH_* env)
exec_args=()
[ -n "${RALPH_MODEL:-}" ] && exec_args+=(-e "RALPH_MODEL=$RALPH_MODEL")
[ -n "${RALPH_LOG:-}" ] && exec_args+=(-e "RALPH_LOG=$RALPH_LOG")
exec docker exec "${exec_args[@]}" \
  -e "RALPH_SKILL=${RALPH_SKILL:-/root/.pi/agent/skills/tdd}" \
  -w /workspace "$NAME" \
  bash -lc 'exec /opt/ralph/afk "$@"' _ "$@"
