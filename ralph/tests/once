#!/bin/bash
# 模拟 once：第一次返回 2（还有任务），第二次返回 0（完成）
#
# 两种模式：
#   FAKE_RC=<码>  —— 单发模式：每次都返回指定退出码
#                    （用于测 abort=1 / 用法错误=3 / 迭代上限=2 路径）
#   FAKE_RC 未设置 —— 计数模式：第 1 次调用返回 2，第 2 次起返回 0
#                    计数存于 FAKE_STATE（默认 $PWD/.fake-once.count），
#                    每次 afk 运行前删除该文件即可复现
set -u
state_file="${FAKE_STATE:-$(pwd)/.fake-once.count}"

if [ -n "${FAKE_RC:-}" ]; then
  rc="$FAKE_RC"
else
  n=0
  [ -f "$state_file" ] && n="$(cat "$state_file" 2>/dev/null)"
  n=${n:-0}
  n=$((n + 1))
  printf '%s' "$n" > "$state_file"
  if [ "$n" -eq 1 ]; then rc=2; else rc=0; fi
fi

echo "  [fake once 执行中...]"
echo "  [fake once 退出码: $rc]"
exit "$rc"
